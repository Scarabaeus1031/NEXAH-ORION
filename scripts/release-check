#!/usr/bin/env bash
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

mode=release
if [ "$#" -gt 1 ]; then
  echo "Usage: ./scripts/release-check [--development]" >&2
  exit 2
fi
if [ "$#" -eq 1 ]; then
  [ "$1" = --development ] || {
    echo "Usage: ./scripts/release-check [--development]" >&2
    exit 2
  }
  mode=development
fi

./scripts/check-workspace
./scripts/test

version=$(tr -d '\r\n' < VERSION)
grep -Fq "## [$version]" CHANGELOG.md || {
  echo "CHANGELOG.md has no section for $version." >&2
  exit 1
}

fingerprint=$(./scripts/orion-v1-fingerprint)
[ "$fingerprint" = "$(./scripts/orion-v1-fingerprint)" ] || {
  echo "Canonical fingerprint replay is not deterministic." >&2
  exit 1
}
grep -Fq "$fingerprint" docs/releases/ORION_V1_RELEASE_NOTES.md || {
  echo "Release notes do not publish the canonical fingerprint $fingerprint." >&2
  exit 1
}

if [ ! -d docs/releases/compatibility ] || \
   ! find docs/releases/compatibility -type f -name '*.yaml' -print | grep -q .; then
  echo "No release compatibility record found." >&2
  exit 1
fi

if [ "$mode" = release ]; then
  for adr in docs/adr/[0-9][0-9][0-9][0-9]-*.md; do
    [ "$(basename "$adr")" = "0000-template.md" ] && continue
    if grep -Eq '^- Status: (Draft|Proposed)$' "$adr"; then
      echo "A release cannot include Draft or Proposed ADRs: $adr" >&2
      exit 1
    fi
  done
  if [ -n "$(git status --porcelain)" ]; then
    echo "Release check requires a clean working tree." >&2
    exit 1
  fi
fi

echo "Release check passed in $mode mode for $version."
