#!/usr/bin/env bash
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

failures=0

fail() {
  echo "ERROR: $*" >&2
  failures=$((failures + 1))
}

required_files='README.md
CONTRIBUTING.md
GOVERNANCE.md
SECURITY.md
CODE_OF_CONDUCT.md
CHANGELOG.md
VERSION
workspace.yaml
docs/architecture/ORION_ARCHITECTURE.md
docs/architecture/ORION_V1_ARCHITECTURE_FREEZE.md
docs/architecture/ORION_V1_ARCHITECTURE_REVIEW.md
docs/architecture/REPRESENTATION_ARCHITECTURE.md
docs/architecture/operators/OPERATOR_ARCHITECTURE.md
docs/architecture/lyra/LYRA_ARCHITECTURE.md
docs/architecture/plates/README.md
docs/architecture/plates/01_system_perspective.png
docs/architecture/plates/02_orientation_workflow.png
docs/architecture/plates/03_representation_architecture.png
docs/architecture/plates/04_representation_graph.png
docs/architecture/plates/05_transition_contract_anatomy.png
docs/architecture/plates/06_transformation_engine.png
docs/architecture/plates/07_operator_registry.png
docs/architecture/plates/08_lyra_language_layer.png
docs/architecture/plates/09_documentation_projections.png
docs/architecture/plates/10_evidence_inference_boundary.png
docs/architecture/plates/src/01_system_perspective.svg
docs/architecture/plates/src/02_orientation_workflow.svg
docs/architecture/plates/src/03_representation_architecture.svg
docs/architecture/plates/src/04_representation_graph.svg
docs/architecture/plates/src/05_transition_contract_anatomy.svg
docs/architecture/plates/src/06_transformation_engine.svg
docs/architecture/plates/src/07_operator_registry.svg
docs/architecture/plates/src/08_lyra_language_layer.svg
docs/architecture/plates/src/09_documentation_projections.svg
docs/architecture/plates/src/10_evidence_inference_boundary.svg
docs/architecture/transformations/ORIENTATION_TRANSFORM_STACK.md
docs/architecture/transformations/REPRESENTATION_GRAPH.md
docs/architecture/transformations/REPRESENTATION_MATRIX.md
docs/architecture/transformations/TRANSITION_CARDS.md
docs/architecture/transformations/INVARIANTS.md
docs/architecture/transformations/OPEN_ARCHITECTURE_QUESTIONS.md
docs/architecture/baselines/PHASE_0_BASELINE_RECOVERY.md
docs/adr/README.md
docs/adr/0000-template.md
docs/adr/0008-orion-v1-architecture-freeze.md
docs/governance/OWNERSHIP.md
docs/governance/CROSS_REPOSITORY_GOVERNANCE.md
docs/governance/COMPATIBILITY_POLICY.md
docs/releases/RELEASE_STRATEGY.md
docs/releases/VERSIONING.md
docs/releases/PUBLICATION_BASELINE.md
docs/releases/RELEASE_CANDIDATE.md
docs/releases/CORE_COMPATIBILITY_REPORT.md
.github/REPOSITORY_METADATA.md
docs/development/WORKSPACE.md
docs/development/README.md
docs/development/DEVELOPMENT_WORKFLOW.md
docs/development/PHASE_1A_EXECUTION.md
docs/development/PHASE_1B_OLLAMA.md
docs/development/PHASE_1B_CLOSEOUT.md
docs/development/PHASE_2A_CONTEXT.md
docs/development/PHASE_2B_SELECTION.md
docs/development/PHASE_2C_CONTEXT_BRIEF.md
docs/development/PHASE_4A_TRANSFORMATION_ENGINE.md
docs/development/PHASE_4A_CLOSEOUT.md
docs/development/PHASE_4A_CLOSEOUT.sha256
docs/development/PHASE_5A_OPERATOR_REGISTRY.md
docs/development/PHASE_6A_LYRA_LANGUAGE.md
docs/development/PHASE_6B_LYRA_INTEGRATION.md
docs/development/PHASE_6C_ORIENTATION_SESSIONS.md
docs/orientation_sessions/README.md
docs/orientation_sessions/canonical/full_round_trip.md
docs/orientation_sessions/canonical/clarification_required.md
docs/orientation_sessions/canonical/unsupported_vocabulary.md
docs/orientation_sessions/navigation/existing_route.md
docs/orientation_sessions/explanation/planned_identity.md
docs/orientation_sessions/comparison/report_comparison.md
docs/orientation_sessions/validation/validation_outcome.md
docs/orientation_sessions/blockers/blocked_route.md
docs/orientation_sessions/blockers/missing_operator.md
docs/orientation_sessions/blockers/missing_renderer.md
docs/orientation_sessions/blockers/unknown_representation.md
docs/orientation_sessions/alternatives/registered_alternatives.md
docs/orientation_sessions/inspection/report_metadata.md
pyproject.toml
src/orion/brief_backend.py
src/orion/brief_execution.py
src/orion/context_brief.py
src/orion/context_builder.py
src/orion/context_execution.py
src/orion/document_selector.py
src/orion/selection_execution.py
src/orion/transformation_contracts.py
src/orion/transformation_engine.py
src/orion/operator_registry.py
src/orion/lyra/__init__.py
src/orion/lyra/exceptions.py
src/orion/lyra/explanation.py
src/orion/lyra/models.py
src/orion/lyra/translator.py
src/orion/lyra/vocabulary.py
src/orion/lyra_execution.py
src/orion/contracts.py
src/orion/backend.py
src/orion/fake_backend.py
src/orion/ollama_backend.py
src/orion/validation.py
src/orion/executor.py
tests/test_execution.py
tests/test_ollama_backend.py
tests/test_context_builder.py
tests/test_document_selector.py
tests/test_context_brief.py
tests/test_transformation_engine.py
tests/test_operator_registry.py
tests/test_lyra.py
tests/test_orientation_sessions.py
tests/integration/test_ollama_integration.py
scripts/test
scripts/test-ollama-integration
scripts/check-architecture-consistency
scripts/check-boundaries
scripts/check-architecture-plates
scripts/generate-architecture-plates'

while IFS= read -r path; do
  [ -f "$path" ] || fail "Missing required file: $path"
done <<EOF
$required_files
EOF

./scripts/check-boundaries || failures=$((failures + 1))
./scripts/check-architecture-plates || failures=$((failures + 1))

version=$(tr -d '\r\n' < VERSION)
echo "$version" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$' || \
  fail "VERSION is not valid Semantic Versioning: $version"

adr_numbers=
for adr in docs/adr/[0-9][0-9][0-9][0-9]-*.md; do
  [ -e "$adr" ] || continue
  number=$(basename "$adr" | cut -d- -f1)
  [ "$number" = 0000 ] && continue
  grep -Eq '^- Status: (Draft|Proposed|Accepted|Rejected|Superseded)$' "$adr" || \
    fail "ADR has invalid or missing status: $adr"
  grep -Eq '^- Date: [0-9]{4}-[0-9]{2}-[0-9]{2}$' "$adr" || \
    fail "ADR has invalid or missing date: $adr"
  grep -Eq '^- Decision owner: .+' "$adr" || \
    fail "ADR has no decision owner: $adr"
  grep -Fq "($(basename "$adr"))" docs/adr/README.md || \
    fail "ADR is missing from docs/adr/README.md: $adr"
  case " $adr_numbers " in
    *" $number "*) fail "Duplicate ADR number: $number" ;;
  esac
  adr_numbers="$adr_numbers $number"
done

core_revision=$(awk '
  /^  - id: nexah-core$/ { in_core = 1; next }
  in_core && /^  - id:/ { exit }
  in_core && $1 == "revision:" { print $2; exit }
' workspace.yaml)

echo "$core_revision" | grep -Eq '^[0-9a-f]{40}$' || \
  fail "Core revision in workspace.yaml is not a full commit hash."

for forbidden in .workspace source_material models outputs runs; do
  if git ls-files "$forbidden" | grep -q .; then
    fail "Forbidden local path is tracked: $forbidden"
  fi
done

if grep -ERn \
  '^[[:space:]]*(from|import)[[:space:]]+(openai|anthropic|ollama|requests|httpx|aiohttp|grpc|boto3)([.[:space:]]|$)' \
  src tests >/dev/null 2>&1; then
  fail "A provider SDK or third-party network client is imported."
fi

if grep -ERn --exclude='ollama_backend.py' \
  '^[[:space:]]*(from|import)[[:space:]]+(urllib|http|socket)([.[:space:]]|$)' \
  src/orion >/dev/null 2>&1; then
  fail "Network imports must remain inside the Ollama adapter."
fi

grep -Fq 'dependencies = []' pyproject.toml || \
  fail "ORION must declare no provider SDK or third-party runtime dependency."

if ! git diff --check; then
  fail "Git whitespace check failed."
fi

core_target="$repo_root/.workspace/repositories/NEXAH"
if [ -e "$core_target" ] || [ -L "$core_target" ]; then
  if ! git -C "$core_target" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    fail "Connected Core path is not a Git repository."
  else
    actual_revision=$(git -C "$core_target" rev-parse HEAD)
    [ "$actual_revision" = "$core_revision" ] || \
      fail "Connected Core is at $actual_revision, expected $core_revision."
    [ -z "$(git -C "$core_target" status --porcelain)" ] || \
      fail "Connected Core working tree is not clean."
  fi
fi

if [ "$failures" -ne 0 ]; then
  echo "$failures workshop check(s) failed." >&2
  exit 1
fi

echo "Workshop checks passed for ORION $version."
