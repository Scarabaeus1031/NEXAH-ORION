#!/usr/bin/env python3
"""Verify Phase 3/4 graph and contract terminology without changing files."""

from __future__ import annotations

from pathlib import Path
import re
import sys


ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))

from orion.transformation_contracts import (  # noqa: E402
    DEFAULT_REPRESENTATION_GRAPH,
    DEFAULT_TRANSITION_CONTRACTS,
)
from orion.operator_registry import DEFAULT_OPERATOR_REGISTRY  # noqa: E402


def fail(message: str) -> None:
    failures.append(message)


def table_value(text: str, field: str, path: Path) -> str:
    match = re.search(rf"^\| {re.escape(field)} \| (.+) \|$", text, re.MULTILINE)
    if match is None:
        fail(f"{path.relative_to(ROOT)}: missing table field {field}")
        return ""
    return match.group(1)


failures: list[str] = []
base = ROOT / "docs" / "architecture" / "transformations"
graph_text = (base / "REPRESENTATION_GRAPH.md").read_text(encoding="utf-8")
cards_text = (base / "TRANSITION_CARDS.md").read_text(encoding="utf-8")
spec_text = (
    base / "contracts" / "TRANSITION_CONTRACT_SPECIFICATION.md"
).read_text(encoding="utf-8")
freeze_path = ROOT / "docs" / "architecture" / "ORION_V1_ARCHITECTURE_FREEZE.md"
freeze_text = freeze_path.read_text(encoding="utf-8")
architecture_text = (ROOT / "docs" / "architecture" / "ORION_ARCHITECTURE.md").read_text(
    encoding="utf-8"
)
adr_freeze_text = (
    ROOT / "docs" / "adr" / "0008-orion-v1-architecture-freeze.md"
).read_text(encoding="utf-8")

if "Status: Frozen ORION v1 Architecture Baseline" not in architecture_text:
    fail("ORION architecture is not marked as the frozen v1 baseline")
if "- Status: Accepted" not in adr_freeze_text:
    fail("ADR-0008 architecture freeze is not accepted")
if (ROOT / "VERSION").read_text(encoding="utf-8").strip() != "0.3.0-dev.0":
    fail("F1 architecture baseline must remain at 0.3.0-dev.0")

canonical_terms = (
    "Orientation Object",
    "Representation",
    "Representation Target",
    "Transformation Plan",
    "Transformation Report",
    "Transition Contract",
    "Operator Registry",
    "Transformation Engine",
    "LYRA",
    "Orientation Session",
)
for term in canonical_terms:
    if f"| {term} |" not in freeze_text:
        fail(f"freeze baseline is missing canonical term: {term}")

edges = DEFAULT_REPRESENTATION_GRAPH.edges
contracts = DEFAULT_TRANSITION_CONTRACTS.contracts
operators = DEFAULT_OPERATOR_REGISTRY.operators
if tuple(edge.transition_id for edge in edges) != tuple(
    contract.transition_id for contract in contracts
):
    fail("runtime graph and contract registry transition IDs differ")
if tuple(edge.transition_id for edge in edges) != tuple(
    operator.implemented_transition_ids[0] for operator in operators
):
    fail("runtime graph and operator registry transition IDs differ")

card_blocks: dict[str, str] = {}
for block in re.split(r"(?=^## T\d{2} — )", cards_text, flags=re.MULTILINE):
    heading = re.match(r"## (T\d{2}) — ([^\n]+)", block)
    if heading is not None:
        card_blocks[heading.group(1)] = block

for edge in edges:
    transition_id = edge.transition_id
    expected_name = (
        f"{edge.source_representation} → {edge.target_representation}"
    )
    contract = DEFAULT_TRANSITION_CONTRACTS.get(transition_id)
    if contract is None:
        fail(f"runtime contract missing: {transition_id}")
        continue
    if (
        contract.source_representation != edge.source_representation
        or contract.target_representation != edge.target_representation
    ):
        fail(f"runtime endpoints differ for {transition_id}")
    if contract.operator_status not in ("unknown", "candidate"):
        fail(f"runtime operator status is overstated for {transition_id}")
    if contract.has_executable_operator or contract.has_renderer:
        fail(f"runtime capability unexpectedly executable for {transition_id}")

    graph_pattern = re.compile(
        rf"^\| \[`{transition_id}`\]\(contracts/{transition_id}\.md\) "
        rf"\| ([^|]+) \| ([^|]+) \| [^|]+ \| [^|]+ \| `([^`]+)` \|$",
        re.MULTILINE,
    )
    graph_match = graph_pattern.search(graph_text)
    if graph_match is None:
        fail(f"Representation Graph registry row missing: {transition_id}")
    else:
        graph_source, graph_target, graph_evidence = (
            value.strip() for value in graph_match.groups()
        )
        if (graph_source, graph_target) != (
            edge.source_representation,
            edge.target_representation,
        ):
            fail(f"Representation Graph endpoints differ for {transition_id}")
        if graph_evidence != contract.evidence_level:
            fail(f"Representation Graph evidence differs for {transition_id}")

    block = card_blocks.get(transition_id)
    if block is None:
        fail(f"Transition Card missing: {transition_id}")
    else:
        heading = re.match(rf"## {transition_id} — ([^\n]+)", block)
        if heading is None or heading.group(1) != expected_name:
            fail(f"Transition Card heading differs for {transition_id}")
        card_source = table_value(block, "Source", base / "TRANSITION_CARDS.md")
        card_target = table_value(block, "Target", base / "TRANSITION_CARDS.md")
        evidence = re.search(
            r"^\| Evidence Status \| `([^`]+)`",
            block,
            re.MULTILINE,
        )
        if (card_source, card_target) != (
            edge.source_representation,
            edge.target_representation,
        ):
            fail(f"Transition Card endpoints differ for {transition_id}")
        if evidence is None or evidence.group(1) != contract.evidence_level:
            fail(f"Transition Card evidence differs for {transition_id}")

    contract_path = base / "contracts" / f"{transition_id}.md"
    contract_text = contract_path.read_text(encoding="utf-8")
    documented_source = table_value(
        contract_text,
        "Source Representation",
        contract_path,
    )
    documented_target = table_value(
        contract_text,
        "Target Representation",
        contract_path,
    )
    documented_evidence = table_value(contract_text, "Evidence Level", contract_path)
    documented_operator = table_value(contract_text, "Operator Status", contract_path)
    if (documented_source, documented_target) != (
        edge.source_representation,
        edge.target_representation,
    ):
        fail(f"normalized contract endpoints differ for {transition_id}")
    if documented_evidence != f"`{contract.evidence_level}`":
        fail(f"normalized contract evidence differs for {transition_id}")
    if not documented_operator.startswith(f"`{contract.operator_status}`"):
        fail(f"normalized contract operator status differs for {transition_id}")
    if contract.documentation_ref != str(contract_path.relative_to(ROOT)):
        fail(f"runtime documentation reference differs for {transition_id}")

    operator_entries = DEFAULT_OPERATOR_REGISTRY.for_transition(transition_id)
    if len(operator_entries) != 1:
        fail(f"operator registry must contain exactly one entry for {transition_id}")
    else:
        operator = operator_entries[0]
        if operator.status.value != contract.operator_status:
            fail(f"operator registry status differs for {transition_id}")
        if operator.evidence_level != contract.evidence_level:
            fail(f"operator registry evidence differs for {transition_id}")
        if not operator.supports_contract(
            transition_id,
            contract.contract_version,
        ):
            fail(f"operator registry contract compatibility differs for {transition_id}")
        if operator.executable:
            fail(f"operator registry unexpectedly executable for {transition_id}")

    spec_pattern = re.compile(
        rf"^\| \[`{transition_id}`\]\({transition_id}\.md\) \| "
        rf"([^|]+) \| `([^`]+)` \| ([^|]+) \|$",
        re.MULTILINE,
    )
    spec_match = spec_pattern.search(spec_text)
    if spec_match is None:
        fail(f"TransitionContract catalog row missing: {transition_id}")
    else:
        spec_transition, spec_evidence, spec_operator = (
            value.strip() for value in spec_match.groups()
        )
        if spec_transition != expected_name:
            fail(f"TransitionContract catalog endpoints differ for {transition_id}")
        if spec_evidence != contract.evidence_level:
            fail(f"TransitionContract catalog evidence differs for {transition_id}")
        if spec_operator != contract.operator_status:
            fail(f"TransitionContract catalog operator differs for {transition_id}")

if failures:
    print("Architecture consistency checks failed:", file=sys.stderr)
    for failure in failures:
        print(f"- {failure}", file=sys.stderr)
    raise SystemExit(1)

print(
    "Architecture consistency checks passed for 15 graph edges, cards, "
    "contracts, graph/contract/operator runtime registries, and the F1 freeze."
)
